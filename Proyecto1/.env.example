# Copiar a .env y ajustar contraseñas:  cp .env.example .env

# --- Fuente transaccional (OLTP) ---
OLTP_ADMIN_USER=sgfood_admin
OLTP_ADMIN_PASSWORD=sgfood_admin_pwd
OLTP_DB=sgfood_oltp
OLTP_HOST=localhost
OLTP_PORT=55433
# Usuario de solo lectura con el que el ETL extrae (lo crea sql/oltp/02_etl_reader.sh)
OLTP_USER=etl_reader
OLTP_PASSWORD=etl_reader_pwd

# --- Data Warehouse ---
DW_USER=dw_admin
DW_PASSWORD=dw_admin_pwd
DW_DB=sgfood_dw
DW_HOST=localhost
DW_PORT=55434

# --- Pipeline ---
PIPELINE_CONFIG=config/pipeline.yaml
DATA_DIR=data

# --- Visualización (usuario de solo lectura sobre marts para Metabase) ---
BI_READER_USER=bi_reader
BI_READER_PASSWORD=bi_reader_pwd
METABASE_PORT=3000

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_DB_PASSWORD=airflow_pwd
# Generar valores propios:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=cambiar_por_clave_fernet_base64
AIRFLOW_JWT_SECRET=cambiar_por_texto_aleatorio_largo
